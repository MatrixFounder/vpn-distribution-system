{
  "v": 1,
  "base_branch": "main",
  "scheduling": {
    "enabled": false
  },
  "max_issues_per_run": 1,
  "max_attempts_per_issue": 2,
  "max_changed_lines": 300,
  "max_changed_files": 10,
  "gate_timeout_sec": 600,
  "human_only_categories": [
    "honest-scope",
    "tech-debt"
  ],
  "protected_paths": [
    "LICENSE",
    ".claude/settings.json",
    ".claude/settings.local.json",
    "docs/feedback/config.json",
    "docs/feedback/heal-config.json",
    "Makefile",
    ".github/workflows/ci.yml"
  ],
  "gates": {
    "control-plane": {
      "unit": "make lint-py typecheck-py test-py"
    },
    "node-agent": {
      "unit": "make lint-go test-go"
    },
    "web": {
      "unit": "make lint-web typecheck-web test-web"
    }
  }
}
