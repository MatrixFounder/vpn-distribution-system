# Переменные окружения стенда и разработки — без секретов (§10.3). Секреты — файлы в
# deploy/compose/secrets/ (перечень: secrets/README.md).
#
# Использование: cp deploy/compose/.env.example deploy/compose/.env && chmod 600 deploy/compose/.env
# и передавать файл явно: docker compose --env-file deploy/compose/.env -f … up -d
# Значения ниже — умолчания стенда; для разработки достаточно скопировать файл как есть.

# --- Домены (§10.4; DNS, ACME и HSTS — задача 001.66) ---
CABINET_DOMAIN=cabinet.example.com
ADMIN_DOMAIN=admin.example.com
# Два домена подписки через запятую (Н-25, R-14)
SUBSCRIPTION_DOMAINS=sub1.example.com,sub2.example.com
# Домен отправителя писем (SPF, DKIM, DMARC — R-41)
MAIL_DOMAIN=mail.example.com

# --- Режимы приложения ---
# dev | stand | prod
APP_ENV=stand
LOG_LEVEL=info
# Число процессов uvicorn роли api (два на ядро хоста, §3.2 C-01). Не действует при
# APP_RELOAD=1 (docker-compose.dev.yml): reload работает в один процесс.
APP_WORKERS=2

# --- nginx: адрес и порты публикации на хосте ---
BIND_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Агентский server (mTLS, /agent/v1) и enrollment server (/agent/v1/enroll)
AGENT_PORT=8443
ENROLL_PORT=8444

# --- Только docker-compose.dev.yml: PostgreSQL и Redis на хосте ---
# По умолчанию только петлевой интерфейс; для доступа с другой машины (например, с
# рабочего Mac к VM) укажите адрес интерфейса VM.
DEV_BIND_ADDR=127.0.0.1
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- PostgreSQL: команда архивации WAL (archive_mode всегда on, Н-9) ---
# Не задано — локальный архив на томе с удалением сегментов старше 3 суток (умолчание в
# docker-compose.yml); задача 001.67 задаёт pgbackrest --stanza=main archive-push %p
# PG_ARCHIVE_COMMAND=
